# Server bind
HOST=0.0.0.0
PORT=3000

# Important: set to your public domain when deploying to AWS.
# Example: https://order.example.com
PUBLIC_BASE_URL=http://127.0.0.1:3000

# SQLite database location (relative to project root)
DB_PATH=database/store.sqlite3

# Reverse proxy trust (AWS ALB / Nginx / CloudFront usually needs true)
TRUST_PROXY=true

# Debug request logs: 1 = on, 0 = off
DEBUG_REQUESTS=0

# In-store anti-remote-order protection
# true  = customers must enter table access code before cart/order actions
# false = disable access code/session gate
ZONE_ACCESS_CODE_REQUIRED=true

# Access code length per table/room
ZONE_ACCESS_CODE_LENGTH=4

# Session lifetime after successful access verification
ZONE_SESSION_TTL_MINUTES=120

# After checkout, rotate table access code automatically
ROTATE_ACCESS_CODE_ON_CHECKOUT=true

# Frontend style compatibility:
# true  = allow inline style attributes (easier for current templates)
# false = strict CSP (requires removing all inline styles from HTML)
CSP_ALLOW_INLINE_STYLE=true
