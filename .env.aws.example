HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=https://your-domain.com
DB_PATH=database/store.sqlite3
# SQLite 锁等待时间（毫秒）：高并发建议 >= 8000
SQLITE_BUSY_TIMEOUT_MS=10000
# 写入排队开关（FIFO）
WRITE_QUEUE_ENABLED=true
# 写入队列最大积压：高峰期建议 5000
WRITE_QUEUE_MAX_SIZE=5000
TRUST_PROXY=true
DEBUG_REQUESTS=0
ZONE_ACCESS_CODE_REQUIRED=false
ZONE_ACCESS_CODE_LENGTH=4
ZONE_SESSION_TTL_MINUTES=120
ROTATE_ACCESS_CODE_ON_CHECKOUT=false
CSP_ALLOW_INLINE_STYLE=true
